T*
(axes[0].scatter\(x, y, alpha=0.6, color='steelblue', s=20\)) Tj
T*
(axes[0].set_title\(f'y = xA?  a??  r = {r_linear:.3f} \(heatmap mostraria "sem) Tj
T*
(correlaA?A?o"\)',) Tj
T*
(                  fontsize=10, fontweight='bold'\)) Tj
T*
(axes[0].set_xlabel\('x'\)) Tj
T*
(axes[0].set_ylabel\('y'\)) Tj
T*
( ) Tj
T*
(# ComparaA?A?o com relaA?A?o linear forte \(Iris\)) Tj
T*
(sns.scatterplot\(data=iris, x='petal_length', y='petal_width',) Tj
T*
(                hue='species', palette='Set2', ax=axes[1], alpha=0.7\)) Tj
T*
